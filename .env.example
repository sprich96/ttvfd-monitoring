# Copy to .env and fill in. .env is gitignored.
COMPOSE_PROJECT_NAME=ttvfd-monitoring

# Persistent data root (bind mounts). Back this path up.
DATA_ROOT=/srv/monitoring

# Canonical Grafana name (sets root_url) + extra names on the cert; Caddy also serves HOST_IP.
# tls internal until a real cert is decided.
GRAFANA_HOSTNAME=grafana.ttvfd.com
GRAFANA_ALIASES=monitor-grafana.ttvfd.com, monitor-grafana
HOST_IP=10.1.6.25

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Prometheus retention: whichever limit is hit first
PROM_RETENTION=30d
PROM_RETENTION_SIZE=10GB

# ntfy.sh alerting. Topic reserved on the ntfy.sh account; NTFY_TOKEN = tk_... access token.
# template=alertmanager renders the Alertmanager webhook JSON; priority 5=urgent, 3=default.
NTFY_TOPIC=<random-topic>
NTFY_URL_CRITICAL=https://ntfy.sh/${NTFY_TOPIC}?template=alertmanager&priority=5&tags=rotating_light
NTFY_URL_WARNING=https://ntfy.sh/${NTFY_TOPIC}?template=alertmanager&priority=3&tags=warning
NTFY_TOKEN=tk_changeme

# TLS in front of Grafana only. Internal CA until a real cert is decided;
# trust root: ${DATA_ROOT}/caddy/data/caddy/pki/authorities/local/root.crt
{
	admin localhost:2019
	# Clients send no SNI when connecting by IP; serve the IP cert then.
	default_sni {$HOST_IP}
}

{$GRAFANA_HOSTNAME}, {$GRAFANA_ALIASES}, {$HOST_IP} {
	tls internal
	encode zstd gzip
	reverse_proxy grafana:3000
}
